// Main common configuration
{
    "url": "https://developer.apple.com",
    "plugins": {
      // JLPluginHello is an example custom plugin inside lib/common/sources/plugins. Can be @lib/xcode or @lib/android for just a specific platform.
      // e.g @lib/xcode/JLPluginHello will translate to lib/common/sources/plugins/JLPluginHello/xcode
      "JLPluginHello": "@lib/JLPluginHello",
      // Example Optional Xcode core only plugin @jasonelle/xcode. For android would be @jasonelle/android
      // e.g @jasonelle/xcode/JLPluginHello will translate to sources/xcode/JLPluginHello
      "JLPluginAppleSignIn": "@jasonelle/xcode/JLPluginAppleSignIn",
      // Optional Android and Xcode core plugin @jasonelle
      "JLPluginCookies": "@jasonelle",
      "JLPluginDevice": "@jasonelle"
    }
}
