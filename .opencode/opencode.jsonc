{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail",
    "superpowers@git+https://github.com/obra/superpowers.git",
  ],
  "formatter": true,
  "instructions": [],
  "compaction": {
      "auto": true,
      "prune": true,
      "reserved": 10000
    },

  "watcher": {
      "ignore": [
        "node_modules/**",
        "dist/**",
        "build/**",
        ".git/**"
      ]
    },

  "permission": {
      "skill": {
        "*": "allow"
      }
    }
}
